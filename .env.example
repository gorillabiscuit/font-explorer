# Vibe search runs through Claude Code on your Claude subscription. No API key needed.
#
# Option 1 (nothing to put here): sign Claude Code in once with `claude auth login`.
# Option 2: run `claude setup-token` and paste the long-lived token it prints:
CLAUDE_CODE_OAUTH_TOKEN=

# Only if the server can't find the `claude` command (use the output of `which claude`):
# CLAUDE_BIN=/Users/you/.local/bin/claude

# Model for vibe search:
# VIBE_MODEL=claude-haiku-4-5-20251001
